<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup rules: only the session history and the settings are backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="focus.db" />
        <include domain="sharedpref" path="focus_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="focus.db" />
        <include domain="sharedpref" path="focus_settings.xml" />
    </device-transfer>
</data-extraction-rules>
